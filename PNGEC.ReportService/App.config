<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!--Use for environment-->
    <add key="DevelopmentApiURL" value="http://ms.projectspreview.net:2525/api/" />
    <!--<add key="TrainingApiURL" value="http://20.231.26.70:5003/api/" />
	<add key="ProductionApiURL" value="http://20.231.26.70:5002/api/" />-->
    <!--<add key="TrainingApiURL" value="http://localhost:57712/api/" />
	  <add key="ProductionApiURL" value="http://localhost:57712/api/" />-->
    <add key="TrainingApiURL" value="http://20.231.26.70:5003/api/" />
    <add key="ProductionApiURL" value="http://20.231.26.70:5002/api/" />
    <add key="SuperAdminId" value="1" />
    <add key="DownloadReportFolderName" value="DownloadReports" />
    <add key="IsGeoFromProduction" value="true" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
