<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
	</startup>
	<appSettings>
		<add key="BaseAddress" value="http://localhost:57712/" />

		<add key="ServerName" value="smtp.gmail.com" />
		<add key="Port" value="587" />
		<add key="EnableSsl" value="true" />
		<add key="UseDefaultCredentials" value="false" />
		<add key="FromAddress" value="" />
		<add key="Password" value="" />

		<!--This is use for Nightly Summary Report (Generate PDF & Send Email)-->
		<!-- 0 = Sunday, 1 = Monday,...., 6 = Saturday -->
		<add key="dayOfWeek" value="0" />
	</appSettings>
  <runtime>
